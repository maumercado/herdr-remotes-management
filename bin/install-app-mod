#!/bin/sh
# Puts the Herdr app mod in place: ~/.config/herdr-app/mods/herdr-machines
# becomes a link to this plugin's app-mod folder.
#
# herdr runs this as a build step (`herdr plugin install` and `update`) and as
# a startup hook (each time a herdr server starts), so an installed or linked
# plugin keeps the link pointing at its current files. It exits right away
# when the link is already right.
#
# Skipped when the Herdr app has no config folder yet, or with
# HERDR_MACHINES_SKIP_APP_MOD=1. A folder or link of the same name that this
# script did not make is left alone.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
app="$HOME/.config/herdr-app"
dest="$app/mods/herdr-machines"
marker=".installed-by-herdr-plugin"
say() { echo "herdr-machines: $*"; }

if [ "${HERDR_MACHINES_SKIP_APP_MOD:-}" = 1 ]; then
  say "HERDR_MACHINES_SKIP_APP_MOD=1, leaving the app mod out"
  exit 0
fi
if [ ! -d "$app" ]; then
  say "no $app yet, so the app mod is not set up (open the Herdr app once; herdr links it at its next start)"
  exit 0
fi

# Ours: a link to some herdr-machines plugin's app-mod folder, or an older
# copy carrying the marker file.
ours() {
  if [ -L "$dest" ]; then
    target=$(readlink "$dest")
    case $target in
      */app-mod) grep -q '^id = "herdr-machines"$' "${target%/app-mod}/herdr-plugin.toml" 2>/dev/null ;;
      *) return 1 ;;
    esac
  else
    [ -f "$dest/$marker" ]
  fi
}

if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$root/app-mod" ]; then
  exit 0
fi
if { [ -e "$dest" ] || [ -L "$dest" ]; } && ! ours; then
  say "$dest exists and was not set up by this plugin, leaving it alone"
  exit 0
fi

mkdir -p "$app/mods"
tmp="$app/mods/.herdr-machines.link.$$"
ln -s "$root/app-mod" "$tmp"
rm -rf "$dest"
mv "$tmp" "$dest"
say "app mod linked: $dest -> $root/app-mod"

if command -v herdr-app >/dev/null 2>&1; then
  herdr-app check "$dest" || say "warning: herdr-app check reported problems with the mod" >&2
fi
