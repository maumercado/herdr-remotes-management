#!/bin/sh
# Starts the herdr-machines CLI and passes every argument on.
# Node: $HERDR_MACHINES_NODE, else `node` on PATH when it is 22.18 or newer,
# else `fnm exec` with this repo's .node-version.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
main="$root/src/main.ts"

if [ -n "${HERDR_MACHINES_NODE:-}" ]; then
  exec "$HERDR_MACHINES_NODE" "$main" "$@"
fi

if command -v node >/dev/null 2>&1 &&
  node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 18) ? 0 : 1)' 2>/dev/null; then
  exec node "$main" "$@"
fi

if command -v fnm >/dev/null 2>&1; then
  exec fnm exec --using="$root/.node-version" node "$main" "$@"
fi

echo "herdr-machines: needs Node 22.18 or newer on PATH (found: $(node --version 2>/dev/null || echo none))" >&2
exit 1
